{
  "name": "sprint3",
  "version": "1.0.0",
  "description": "codeit sprint mission5",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "nodemon --exec ts-node src/app.ts",
    "migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "generate": "prisma generate --schema=src/prisma/schema.prisma",
    "studio": "prisma studio --schema=src/prisma/schema.prisma",
    "reset": "prisma migrate reset --schema=src/prisma/schema.prisma",
    "seed": "node dist/prisma/seed.js"
  },
  "author": "selentia",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "socket.io": "^4.8.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
